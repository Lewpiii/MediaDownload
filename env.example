# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here

# Logging Configuration
LOGS_CHANNEL_ID=your_logs_channel_id_here
WEBHOOK_URL=your_webhook_url_here

# External Services
GOFILE_TOKEN=your_gofile_token_here
TOP_GG_TOKEN=your_topgg_api_token_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values above with your actual tokens
# 3. For TOP_GG_TOKEN:
#    - Go to https://top.gg/bot/YOUR_BOT_ID
#    - Click "Edit Bot" -> "Webhooks"
#    - Copy your Authorization token
# 4. Never commit the .env file to git (it's in .gitignore)
